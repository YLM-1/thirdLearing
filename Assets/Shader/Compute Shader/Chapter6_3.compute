#pragma kernel ComputeMeshTest

#pragma kernel InitParticle
#pragma kernel ComputeParticle
#pragma kernel ComputeMesh

#pragma kernel ComputeExternalForce

#pragma kernel InitDistanceConstraints
#pragma kernel InitCollisionConstraints
#pragma kernel ComputeFinalConstraints

#pragma kernel ComputeDistanceConstraints
#pragma kernel ComputeCollisionConstraints

//Step1.0:
ByteAddressBuffer originalIndexBuffer;
ByteAddressBuffer originalVertexBuffer;
RWByteAddressBuffer vertexBuffer;

float time;
float deltaTime;

//Step2.0
struct Particle
{
    float3 position;
    float3 predictPosition;
    float3 velocity;
    float3 normal;
    float mass;
    int constraintsType;
};
RWStructuredBuffer<Particle> particleBuffer;

uint particleCount;
uint triangleCount;
float4x4 localToWorldMatrix;
float4x4 worldToLocalMatrix;

//Step3.0
float3 gravity;
float3 wind;
float density;
float dampingForec;

//Step4.0
struct SphereColliderDesc
{
    float3 center;  //世界坐标系下
    float radius;
};

struct CollisionInfo
{
    float3 constrainPosition;
    float3 velocity;
    float3 normal;
};

struct BoxColliderDesc
{
    float3 min;
    //xyz代表轴在世界空间下的朝向，w代表length
    float4 ax;
    float4 ay;
    float4 az;
};

struct CapsuleColliderDesc
{
    float3 origin;//世界坐标系下胶囊体底端半球球心的世界坐标
    float radius;
    float4 axis;//胶囊体中间圆柱段的高度/长度（即两端半球球心之间的距离，`height - 2 * radius`）
};

RWStructuredBuffer<CollisionInfo> collisionInfoBuffer;
StructuredBuffer<SphereColliderDesc> sphereColliderBuffer;
StructuredBuffer<BoxColliderDesc> boxColliderBuffer;
StructuredBuffer<CapsuleColliderDesc> capsuleColliderBuffer;

int sphereColliderCount;
int boxColliderCount;
int capsuleColliderCount;

float iteratorCount;
float iteratorIndex;
// 作为枚举的uint一定要声明为静态变量
const static int ConstraintsTypeDistance = 0;
const static int ConstraintsTypePin = 1;
const static int ConstraintsTypeCollision = 2;


//Step5.1
struct EdgeInfo
{
    uint index0;
    uint index1;
    float restLength;
};
RWStructuredBuffer<EdgeInfo> edgeInfoBuffer;
int edgeInfoCount;
float strengthStiffness;
float compressStiffness;

//step1.0
void LoadOriginalVertex(uint index,out float3 position,out float3 normal)
{
    uint pi = index*11*4;// index * (3[position.xyz] + 3[normal.xyz] + 3[tangent.xyz] + 2[uv.xy]) * 4[bytes]
    uint ni = pi+3*4;

    //Load3：负责把 12 字节的原始数据搬出来（拿到的是 uint3）
    //asfloat(...)：负责重新解读这 12 字节（把 uint3 重新解读为 float3）。
    position = asfloat(originalVertexBuffer.Load3(pi));
    normal = asfloat(originalVertexBuffer.Load3(ni));
}

float3 DisplacePosition(float3 p)
{
    float3 disp = float3(
        0.1 * (sin(1.3 * p.y + 4.1 * time) + sin(2.9 * p.z + 5.3 * time)),
        0.1 * (sin(1.9 * p.z + 4.3 * time) + sin(3.1 * p.x + 5.9 * time)),
        0.1 * (sin(2.3 * p.x + 4.7 * time) + sin(3.7 * p.y + 6.1 * time))
        );
    return p + disp;
}

void StoreVertex(uint index,float3 position,float3 normal)
{
    uint pi = index*11*4;
    uint ni = pi + 3*4;

    //Store3 是 RWByteAddressBuffer 的写入函数，表示“从 pi 字节偏移量开始，连续写入 12 个字节（3 个 32位字）的数据”。
    vertexBuffer.Store3(pi,asuint(position));
    vertexBuffer.Store3(ni,asuint(normal));
}

inline float4 QuatBetween2Vectors(float3 v0, float3 v1)
{
    if (length(v0) < 0.01 || length(v1) < 0.01)
        return float4(0, 0, 0, 1);
    else
    {
        float3 nv0 = normalize(v0);
        float3 nv1 = normalize(v1);

        float3 hv = normalize((nv0 + nv1) / 2);
        return float4(cross(nv0, hv), dot(nv0, hv));
    }
}

inline float3 QuatMul(float4 q, float3 v)
{
    float3 normal = dot(q.xyz, v) * q.xyz + q.w * q.w * v + 2.0 * q.w * cross(q.xyz, v) - cross(cross(q.xyz, v), q.xyz);
    return normalize(normal);
}

Particle GenerateParticle(uint index)
{
    //拿到的是模型坐标系下的position和normal
    //在 Unity（以及所有 3D 软件如 Blender/Maya）中，Mesh 文件（.fbx 或内置网格）里记录的 vertices 和 normals 默认都是相对于该模型自身中心点（Pivot）的相对坐标，即模型局部空间（Local Space）。
    float3 localPosition,localNormal;
    LoadOriginalVertex(index,localPosition,localNormal);

    //转换到世界坐标系下
    float3 worldPosition = mul(localToWorldMatrix,float4(localPosition,1)).xyz;
    float3 worldNormal = mul(localToWorldMatrix,float4(localNormal,0)).xyz;

    //初始化粒子属性
    Particle p = particleBuffer[index];
    p.position = worldPosition;
    p.predictPosition = worldPosition;
    p.velocity = 0;
    p.normal = normalize(worldNormal);
    // 用来记录该粒子是否和碰撞体有碰撞约束，0: Distance距离约束，1：pin固定位置约束，2：Collision碰撞约束
    p.constraintsType = ConstraintsTypeDistance;
    return p;
}

float GetArea(float3 p0,float3 p1,float3 p2)
{
    float3 v0 = p1-p0;
    float3 v1 = p2-p0;
    return 0.5f*length(cross(v0,v1));
}

//每次迭代均为一个三角形
[numthreads(64,1,1)]
void ComputeMeshTest (uint3 id : SV_DispatchThreadID)
{
    if(id.x>=triangleCount)
      return;
    //读取顶点索引
    uint3 triIndex = originalIndexBuffer.Load3(id.x*3*4);// id * 3[triangle vertices] * 4[bytes]

    //读取原始Position和normal
    float3 p0,n0;
    LoadOriginalVertex(triIndex.x,p0,n0);

    float3 p1,n1;
    LoadOriginalVertex(triIndex.y,p1,n1);

    float3 p2,n2;
    LoadOriginalVertex(triIndex.z,p2,n2);

    float3 np0 = DisplacePosition(p0);
    float3 np1 = DisplacePosition(p1);
    float3 np2 = DisplacePosition(p2);

    // 计算出向量（0，0，0）指向p0 和 向量（0，0，0）指向p1之间的旋转，使用四元数表示
    // 计算均在模型坐标空间系下，再使用这个旋转来旋转法线
    float4 q0 = QuatBetween2Vectors(p0,np0);
    float3 nn0 = QuatMul(q0, n0);

    float4 q1 = QuatBetween2Vectors(p1,np1);
    float3 nn1 = QuatMul(q1,n1);

    float4 q2 = QuatBetween2Vectors(p2,np2);
    float3 nn2 = QuatMul(q2,n2);

    //保存新计算好的Position
    StoreVertex(triIndex.x,np0,nn0);
    StoreVertex(triIndex.y,np1,nn1);
    StoreVertex(triIndex.z,np2,nn2);
}

[numthreads(64,1,1)]
void InitParticle (uint3 id : SV_DispatchThreadID)
{
    if(id.x>=triangleCount)
       return;
    
    uint3 triIndex = originalIndexBuffer.Load3(id.x*3*4);

    Particle p0 = GenerateParticle(triIndex.x);
    Particle p1 = GenerateParticle(triIndex.y);
    Particle p2 = GenerateParticle(triIndex.z);

    //对粒子的质量赋初值
    float area = GetArea(p0.position,p1.position,p2.position);
    float mass = density * area/3;
    p0.mass = mass;
    p1.mass = mass;
    p2.mass = mass;

    particleBuffer[triIndex.x] = p0;
    particleBuffer[triIndex.y] = p1;
    particleBuffer[triIndex.z] = p2;
}

[numthreads(64,1,1)]
void ComputeParticle (uint3 id : SV_DispatchThreadID)   
{
    if(id.x>=particleCount)
      return;
    
    Particle p = particleBuffer[id.x];

    //作为测试
    // p.position +=float3(0,-1,0)*deltaTime;

    //处理碰撞约束
    if((p.constraintsType & ConstraintsTypeCollision) == ConstraintsTypeCollision)
       p.velocity = 0;
    else
       p.velocity = (p.predictPosition - p.position)/deltaTime;  
       
    p.position = p.predictPosition;
    p.predictPosition = 0;   

    particleBuffer[id.x] = p;
}

void ComputeVertex(uint index)
{
    Particle p = particleBuffer[index];

    float3 worldPosition = p.position;
    float3 localPosition = mul(worldToLocalMatrix,float4(worldPosition,1)).xyz;

    float3 op,on;
    LoadOriginalVertex(index,op,on);
    float4 q = QuatBetween2Vectors(op,localPosition);

    //计算normal
    float3 newNormal = QuatMul(q,on);
    float3 localNormal = mul(worldToLocalMatrix,float4(newNormal,0)).xyz;

    StoreVertex(index,localPosition,localNormal);
}

[numthreads(64,1,1)]
void ComputeMesh (uint3 id : SV_DispatchThreadID)
{
    if(id.x>=triangleCount)
      return;

    uint3 triIndex = originalIndexBuffer.Load3(id.x*3*4);

    ComputeVertex(triIndex.x);
    ComputeVertex(triIndex.y);
    ComputeVertex(triIndex.z);
}

[numthreads(64,1,1)]
void ComputeExternalForce (uint3 id : SV_DispatchThreadID)
{
    if(id.x>=particleCount)
       return;

    // 这里添加的velocity和predict position是基于 pbd的结构，
	// 不同于传统的 pba （physically based animation）
    Particle p = particleBuffer[id.x];   
    float3 position = p.position;
    float3 velocity = p.velocity;

    //处理重力+风力
    float3 windInNormalDirection = dot(wind,p.normal)*wind;//p.normal为归一化
    float safeMass = max(p.mass,0.000001f);
    float3 v = velocity + (gravity+windInNormalDirection/safeMass)*deltaTime;
    //添加阻力
    v*=max(0,1-dampingForec/safeMass);
    p.predictPosition = position + v*deltaTime;

    particleBuffer[id.x] = p;
}

[numthreads(64,1,1)]
void InitCollisionConstraints(uint3 id : SV_DispatchThreadID)
{
    if(id.x>=particleCount)
       return;

    CollisionInfo collisionInfo = collisionInfoBuffer[id.x];
	collisionInfo.constrainPosition = 0;
	collisionInfo.normal = 0;
	collisionInfo.velocity = 0;

    collisionInfoBuffer[id.x] = collisionInfo;
}

//计算轴约束
struct ConcatInfo
{
    float3 position;
    float3 normal;
};


// 计算粒子是否和碰撞体碰撞，如果碰撞，则得到碰撞信息 ConcatInfo
bool GetClosestSurfacePoint(float3 pos,SphereColliderDesc sphere,out ConcatInfo concatInfo)
{
    //计算粒子是否和sphereCollider碰撞
    float3 c2p = pos - sphere.center;
    float d2 = dot(c2p,c2p);
    float r2 = sphere.radius*sphere.radius;

    if(d2<r2)
    {
        // 如果当前粒子的位置已经在球体的碰撞体内
		// 则让粒子沿着 从球体中心指向当前粒子位置的方向, 移动一个半径的距离，即球体表面
        concatInfo.normal = normalize(c2p);
        concatInfo.position = sphere.center + concatInfo.normal*sphere.radius;

        return true;
    }
    else
        return false;
}

bool GetClosestSurfacePoint(float3 pos,BoxColliderDesc box,out ConcatInfo concatInfo)
{
    //计算粒子是否和BoxCollider碰撞
    // 1. 首先得到从立方体最小点指向当前粒子位置的向量
    float3 m2p = pos - box.min;
    // 2. 得到 该向量在立方体三个边轴上的投影
    float3 projOnAxis = float3(
        dot(m2p,box.ax.xyz),
        dot(m2p,box.ay.xyz),
        dot(m2p,box.az.xyz)
    );
    // 3. 得到立方体三个边轴的长度
    float3 axisLength = float3(box.ax.w,box.ay.w,box.az.w);
    // 4. 判断投影在边轴更靠近左边界还是右边届（0：左边界，1：右边界）
    int3 side = step(axisLength*0.5f,projOnAxis);
    // 5. 计算投影和边轴的距离，并用正负区分是在正轴还是负轴
    int3 signedSide = 1-2*side;// -1：右，1：左
    float3 signeDist = signedSide *(projOnAxis - side *axisLength);

    // 6. 如果所有的投影的距离都 > 0
    bool inside = all(signeDist>0);
    if(inside)
    {
        //得到交点的距离
        //从x轴开始赋初值并判断
        float dst = signeDist.x;
        float4 axis = box.ax;
        int sideFlag = side.x;
        float axisIndex = 0;

        if(signeDist.y<dst)
        {
            dst = signeDist.y;
            axis = box.ay;
            sideFlag = side.y;
            axisIndex = 1;
        }
        if(signeDist.z<dst)
        {
            dst = signeDist.z;
            axis = box.az;
            sideFlag = side.z;
            axisIndex = 2;
        }

        concatInfo.normal = sideFlag>0?axis.xyz:-axis.xyz;
        float offset = projOnAxis[axisIndex] - sideFlag * axis.w;
        concatInfo.position = pos - axis.xyz*offset;
        return true;
    }
    else
        return false;
}

bool GetClosestSurfacePoint(float3 pos,CapsuleColliderDesc capsule,out ConcatInfo concatInfo)
{
    float radius = capsule.radius;
    float4 axis = capsule.axis;
    float3 origin = capsule.origin;
    float3 c2p = pos - origin;

    float projOnAxis = dot(c2p,axis.xyz);

    if(projOnAxis<-radius||projOnAxis>axis.w+radius)
      return false;
    
    float r2 = radius*radius;

    if(projOnAxis>=0&&projOnAxis<=axis.w)
    {
        // 如果轴上的投影在圆柱体之间
		// 计算粒子的位置到轴的垂直距离的平方
        float dist = dot(c2p,c2p) - projOnAxis*projOnAxis;
        if(dist<r2)
        {
            float3 q = axis.xyz*projOnAxis;
            concatInfo.normal = normalize(c2p-q);
            concatInfo.position = origin + q + concatInfo.normal*radius;
            return true;
        }
        else
            return false;
    }

    if(projOnAxis>=-radius&&projOnAxis<0)
    {
        float dist = dot(c2p,c2p);
        if(dist<r2)
        {
            concatInfo.normal = normalize(c2p);
            concatInfo.position = origin + concatInfo.normal*radius;
            return true;
        }
        else 
           return false;
    }

    if(projOnAxis>axis.w&&projOnAxis<axis.w+radius)
    {
        //轴上投影处于另一头附近
        float3 c = axis.xyz * axis.w;
        c2p = c2p - c;
        if(dot(c2p, c2p) < r2)
		{
            concatInfo.normal = normalize(c2p);
            concatInfo.position = origin + c + radius * concatInfo.normal;
            return true;
        }
		else
            return false;
    }
    return false;
}

// 如果粒子和碰撞体产生碰撞
void EnableCollisionConstraints(int index,ConcatInfo concatInfo)
{
    //粒子更新
    Particle p = particleBuffer[index];

    // 标记当前粒子的碰撞标签
    p.constraintsType |= ConstraintsTypeCollision; 
    particleBuffer[index] = p;

    // 粒子碰撞信息的更新
    CollisionInfo collisionInfo = collisionInfoBuffer[index];
    collisionInfo.constrainPosition = concatInfo.position+concatInfo.normal * 0.05f;
    collisionInfo.normal = concatInfo.normal;
	collisionInfo.velocity = 0;

    collisionInfoBuffer[index] = collisionInfo;
}

// 如果粒子和所有碰撞体都没有产生碰撞
Particle DisableCollisionConstraints(Particle p)
{
    //将碰撞标记去除
    p.constraintsType &= ~ConstraintsTypeCollision; 
    return p;
}

[numthreads(64,1,1)]
void ComputeCollisionConstraints (uint3 id : SV_DispatchThreadID)
{
    if(id.x>=particleCount)
      return;
    Particle p = particleBuffer[id.x];
    
    //先判断粒子和所有的球体碰撞体是否有碰撞
    for(int i=0;i<sphereColliderCount;i++)
    {
        SphereColliderDesc sphere = sphereColliderBuffer[i];
        ConcatInfo concatInfo;
        // 解算过程中都使用 predictPosition
        if(GetClosestSurfacePoint(p.predictPosition,sphere,concatInfo))
        {
            EnableCollisionConstraints(id.x,concatInfo);
            return;
        }
    }

    // 再判断粒子和所有的立方体碰撞体是否有碰撞
    for(int j = 0;j<boxColliderCount;j++)
    {
        BoxColliderDesc box = boxColliderBuffer[j];
        ConcatInfo concatInfo;
        if(GetClosestSurfacePoint(p.predictPosition,box,concatInfo))
        {
            EnableCollisionConstraints(id.x,concatInfo);
            return;
        }
    }

    //最后判断是否和胶囊体发生碰撞
    for(int k = 0;k<capsuleColliderCount;k++)
    {
        CapsuleColliderDesc capsule = capsuleColliderBuffer[k];
        ConcatInfo concatInfo;
        if(GetClosestSurfacePoint(p.predictPosition,capsule,concatInfo))
        {
            EnableCollisionConstraints(id.x,concatInfo);
            return;
        }
    }

    particleBuffer[id.x] = DisableCollisionConstraints(p);
}

[numthreads(64,1,1)]
void ComputeFinalConstraints (uint3 id : SV_DispatchThreadID)
{
    if(id.x>=particleCount)
       return;
    Particle p=particleBuffer[id.x];
    
    //处理碰撞相关计算
    int constraintsType = p.constraintsType;
    if((constraintsType & ConstraintsTypeCollision) == ConstraintsTypeCollision)
    {
        float3 position = p.position;

        CollisionInfo collisionInfo = collisionInfoBuffer[id.x];
        float3 deltaP = collisionInfo.constrainPosition - position;
        position+=deltaP*(iteratorIndex/iteratorCount);

        p.predictPosition = position;
        particleBuffer[id.x] = p;
        return;
    }
}

[numthreads(64,1,1)]
void InitDistanceConstraints(uint3 id : SV_DispatchThreadID)
{
    if(id.x>=edgeInfoCount)
       return;
    EdgeInfo edgeInfo = edgeInfoBuffer[id.x];
    uint index0 = edgeInfo.index0;
    uint index1 = edgeInfo.index1;

    float3 pos0 = particleBuffer[index0].position;
    float3 pos1 = particleBuffer[index1].position;
    
    edgeInfo.restLength = length(pos0-pos1);
    edgeInfoBuffer[id.x] = edgeInfo;
}

[numthreads(64,1,1)]
void ComputeDistanceConstraints(uint3 id : SV_DispatchThreadID)
{
    if(id.x>=edgeInfoCount)
      return;
    EdgeInfo edgeInfo = edgeInfoBuffer[id.x];
    
    uint index0 = edgeInfo.index0;
    uint index1 = edgeInfo.index1;

    Particle p0 = particleBuffer[index0];
    Particle p1 = particleBuffer[index1];

    // 牛顿-拉夫逊迭代法: https://matthias-research.github.io/pages/publications/posBasedDyn.pdf

    float m0 = p0.mass;
    float m1 = p1.mass;

    // 两个粒子当前帧的位置得到的向量
    float3 dist = p1.predictPosition-p0.predictPosition;
    // 两个粒子当前帧的距离
    float len = length(dist);
    float3 normal = normalize(dist);

    float err = len - edgeInfo.restLength;
    float3 correct;

    if(err<0)
    {
        // 如果当前两个粒子离得太近，则要拉远一些
        correct = strengthStiffness*normal*err;
    }
    else
    {
        // 如果当前两个粒子离得太远，则要拉近一点
        correct = compressStiffness*normal*err;
    }
    float di = 1.0f / (iteratorCount - iteratorIndex);
    float totalMass = m0+m1;

    // p0 的预测位置 += (纠正方向) * (偏差距离) * (瘦子质量比例) * 时间步长;
    p0.predictPosition += correct*di*m1/totalMass*deltaTime;
    // p1 的预测位置 -= (纠正方向) * (偏差距离) * (胖子质量比例) * 时间步长;
    p1.predictPosition -= correct * di *m0 / totalMass * deltaTime;
    particleBuffer[index0] = p0;
    particleBuffer[index1] = p1;
}


