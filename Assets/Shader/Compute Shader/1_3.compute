// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain
#pragma kernel Green
#pragma kernel FourColors
#pragma kernel Circle
#pragma kernel Square

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float4> Result;
int texResolution;

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    // TODO: insert actual code here!

    Result[id.xy] = float4(1,0,0,1);
}

[numthreads(8,8,1)]
void Green (uint3 id : SV_DispatchThreadID)
{
    // TODO: insert actual code here!

    Result[id.xy] = float4(0,1,0,1);
}

[numthreads(8,8,1)]
void FourColors (uint3 id : SV_DispatchThreadID)
{
    //>>右移一位，本质是除以2
    int halfRes = texResolution>>1;

    // if(id.x>halfRes)
    // {
    //     if(id.y>halfRes)
    //       Result[id.xy] = float4(1,1,0,1);
    //     else
    //       Result[id.xy] = float4(1,0,0,1);  
    // }
    // else
    // {
    //     if(id.y>halfRes)
    //       Result[id.xy] = float4(0,1,0,1);
    //     else
    //       Result[id.xy] = float4(0,0,0,1);  
    // }

    Result[id.xy]=float4(step(halfRes,id.x),step(halfRes,id.y),0,1);
}

float inCircle(float2 pt,float radius)
{
    return length(pt)<radius?1:0;
}

[numthreads(8,8,1)]
void Circle (uint3 id : SV_DispatchThreadID)
{
    //>>右移一位，本质是除以2
    int halfRes = texResolution>>1;

    float res = inCircle((float2)((int2)id.xy-halfRes),(float)(texResolution>>2));
    Result[id.xy]=float4(res,res,0,1);
}

// rect: rect.xy 定义了矩形左下角的xy坐标，rect.z定义了width，rect.w定义了height
float inSquare(float2 pt, float4 rect)
{
    float x = step(rect.x, pt.x) - step(rect.x + rect.z, pt.x);
    float y = step(rect.y, pt.y) - step(rect.y + rect.w, pt.y);

    return x * y;
}

[numthreads(8, 16, 1)]
void Square (uint3 id : SV_DispatchThreadID)
{
    int halfRes = texResolution >> 1;
    int quarterRes = texResolution >> 2;

    float4 rect = float4(quarterRes, quarterRes, halfRes, halfRes);

    float res = inSquare((float2)id.xy, rect);

    Result[id.xy] = float4(0, 0, res, 1);
}

